{
  "rewrites": [
    {
      "source": "/css/(.*)",
      "destination": "/frontend/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/frontend/js/$1"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/market/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/train/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/train",
      "destination": "/api/index.py"
    },
    {
      "source": "/signals",
      "destination": "/api/index.py"
    },
    {
      "source": "/model/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/data/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/features/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/news/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/fundamentals/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/portfolio/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/portfolio",
      "destination": "/api/index.py"
    },
    {
      "source": "/risk",
      "destination": "/api/index.py"
    },
    {
      "source": "/backtest",
      "destination": "/api/index.py"
    },
    {
      "source": "/research/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/models",
      "destination": "/api/index.py"
    },
    {
      "source": "/experiments",
      "destination": "/api/index.py"
    },
    {
      "source": "/realtime/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/predict",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
